+    uint8_t *codeMem = nullptr; // 16 KB
+    uint8_t *dataMem = nullptr; // 16 KB
+    void (*mscal)(uint32_t startPcBytes, uint32_t top, uint32_t itop, uint32_t fbrst, uint64_t codeGeneration, uint32_t *vpuStat) = nullptr;
