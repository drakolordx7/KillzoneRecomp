+            RpcRequest request;
+            std::vector<uint8_t> send;
+            std::function<void(RpcResult)> done;
+            uint64_t submitNs = 0; // PS2X_IOP_RPC_STATS: submit time (queue latency)
+        };
+        [[nodiscard]] bool canOffloadRpc(uint32_t sid);
+        [[nodiscard]] bool submitRpc(AsyncRpc call);
