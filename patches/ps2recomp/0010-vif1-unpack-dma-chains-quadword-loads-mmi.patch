+struct PS2DmaStats
+{
+    using C = std::atomic<uint64_t>;
+    // DMA starts per channel (0 VIF0, 1 VIF1, 2 GIF, 3 fromIPU, 4 toIPU, 5 SIF0, 6 SIF1, 7 SIF2, 8 fromSPR, 9 toSPR)
