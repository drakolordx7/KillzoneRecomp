+            if (phys >= 0x1000F000u && phys < 0x1000F600u)
+                return "io:intc/sio";
+            return "io:other";
+        }
+        if (phys >= PS2_GS_PRIV_REG_BASE && phys < PS2_GS_PRIV_REG_BASE + PS2_GS_PRIV_REG_SIZE)
+            return "gs-priv";
+        if (phys >= PS2_VU0_DATA_BASE && phys < PS2_VU1_CODE_BASE + PS2_VU1_CODE_SIZE)
